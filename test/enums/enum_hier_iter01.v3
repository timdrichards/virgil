//@execute 0=5; 1=10; 2=5; 3=33
// count and for-in cover an open enum's whole hierarchy, and every iterated case
// dispatches to its own method (each case must be live in the method table).
enum E { A, B, _; def m() -> int { return 1; } }
enum E.More {
	C { def m() -> int { return 10; } },
	D { def m() -> int { return 20; } };
	def m() -> int { return 2; }
}
enum E.Other { F }
def main(arg: int) -> int {
	match (arg) {
		0 => return E.count;
		1 => { var sum = 0; for (e in E) sum += e.tag; return sum; }
		2 => { var n = 0; for (e in E) n++; return n; }
		3 => { var sum = 0; for (e in E) sum += e.m(); return sum; }
	}
	return -1;
}
