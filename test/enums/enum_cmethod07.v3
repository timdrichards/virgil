//@execute 0=-1; 1=7; 2=10; 3=7; 4=10
// Per-case overrides on cases of a subtype enum that does not declare the method itself
// (it inherits the root's). Once crashed the compiler (NullCheckException in addVstMethod).
enum Op { NOP, ADD, _; def interpret(x: int) -> int { return -1; } }
enum Op.Ext {
	PUSH7 { def interpret(x: int) -> int { return 7; } },
	DOUBLE { def interpret(x: int) -> int { return x * 2; } }
}
def main(arg: int) -> int {
	var ops: Array<Op> = [Op.NOP, Op.Ext.PUSH7, Op.Ext.DOUBLE];
	match (arg) {
		0 => return ops[0].interpret(5);
		1 => return ops[1].interpret(5);
		2 => return ops[2].interpret(5);
		3 => return Op.Ext.PUSH7.interpret(5);
		4 => return Op.Ext.DOUBLE.interpret(5);
	}
	return -100;
}
