//@execute 0=-1; 1=7; 2=10; 3=-2; 4=10
// Per-case overrides on subtype-enum cases must win over the subtype-level method when
// called through a value of the root type. Native targets once called the subtype method.
enum Op { NOP, ADD, _; def interpret(x: int) -> int { return -1; } }
enum Op.Ext {
	PUSH7 { def interpret(x: int) -> int { return 7; } },
	DOUBLE { def interpret(x: int) -> int { return x * 2; } },
	PLAIN;
	def interpret(x: int) -> int { return -2; }
}
def main(arg: int) -> int {
	var ops: Array<Op> = [Op.NOP, Op.Ext.PUSH7, Op.Ext.DOUBLE, Op.Ext.PLAIN];
	if (arg < 4) return ops[arg].interpret(5);
	var e: Op.Ext = Op.Ext.DOUBLE;
	return e.interpret(5);
}
