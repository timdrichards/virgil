//@execute 0=1; 1=2; 2=4
// An enum that declares its own shortName field keeps it; the synthesized shortName
// member (the case name without the enum prefix) is not added.
enum Cmd(fullName: string, shortName: string) {
	RUN("run", "r"),
	STEP("step", "s"),
	CONTINUE("continue", "cont")
}
def main(arg: int) -> int {
	match (arg) {
		0 => return Cmd.RUN.shortName.length;
		1 => return Cmd.STEP.shortName.length + Cmd.STEP.fullName.length - 3;
		2 => return Cmd.CONTINUE.shortName.length;
	}
	return -1;
}
