//@execute 0=0; 1=3; 2=294
// A component initializer that iterates an open enum and reads a field of every case
// must see the fields of subtype-enum cases, even before anything else refers to the
// subtype enum: reading a field initializes the whole hierarchy.
enum E(label: string) { A("a"), _; }
enum E.More { B("b"), C("c") }
component Table {
	def missing = countMissing();	// cases whose label was not yet initialized
	def total = countAll();
	def chars = sumFirstChars();
}
def countMissing() -> int {
	var n = 0;
	for (e in E) if (e.label == null) n++;
	return n;
}
def countAll() -> int {
	var n = 0;
	for (e in E) n++;
	return n;
}
def sumFirstChars() -> int {
	var sum = 0;
	for (e in E) if (e.label != null) sum += e.label[0];
	return sum;
}
def main(arg: int) -> int {
	match (arg) {
		0 => return Table.missing;
		1 => return Table.total;
		2 => return Table.chars;	// 'a' + 'b' + 'c' = 294
	}
	return -1;
}
